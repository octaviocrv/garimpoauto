# Copie para .env e troque as senhas. O .env não vai para o git.
GARIMPO_DB_USUARIO=garimpo
GARIMPO_DB_SENHA=troque-esta-senha
GARIMPO_DB_ROOT_SENHA=troque-esta-senha-tambem
GARIMPO_DB_PORTA=3390
GARIMPO_DATABASE_URL=mysql://garimpo:troque-esta-senha@127.0.0.1:3390/garimpo_auto
GARIMPO_DATABASE_URL_TESTE=mysql://garimpo:troque-esta-senha@127.0.0.1:3390/garimpo_auto_teste
# FIPE. O token gratuito é opcional. Sem ele o limite padrão fica em 450 chamadas por dia.
GARIMPO_FIPE_TOKEN=
GARIMPO_FIPE_LIMITE_DIA=
GARIMPO_FIPE_TIMEOUT_REQUISICAO_SEGUNDOS=10
GARIMPO_FIPE_TEMPO_PAGINA_SEGUNDOS=4
GARIMPO_FIPE_PAUSA_SEGUNDOS=0.2
GARIMPO_FIPE_REPETICOES=1
GARIMPO_FIPE_BACKOFF_SEGUNDOS=1
